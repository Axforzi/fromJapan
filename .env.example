# Copia este archivo a `.env` y rellena los valores antes de correr la app.
# NUNCA subas el archivo `.env` a tu repositorio (ya está en .gitignore).

# Clave secreta de Flask. Usa una cadena larga y aleatoria en producción.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# URI de conexión a MongoDB. Para MongoDB Atlas (cluster M0 gratuito):
#   mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Si quieres usar una base de datos específica, añade el nombre al final del host
#   o usa la opción `--authenticationDatabase`.
MONGO_URI=mongodb://localhost:27017/fromjapan